            lb.Position = UDim2.fromOffset(lx, 0)
            lb.BackgroundColor3 = Config.Bg
            lb.BackgroundTransparency = 0.5
            lb.Text = ""   -- texto vacío, usamos imagen + label
            lb.Font = Enum.Font.Gotham
            lb.TextSize = 11
            lb.TextColor3 = Theme.state.accent
            lb.Parent = linksRow
            corner(lb, 8)
            uiStroke(lb, Config.Stroke, 1)

            -- Icono PNG
            local iconImg = Instance.new("ImageLabel")
            iconImg.Size = UDim2.fromOffset(14, 14)
            iconImg.Position = UDim2.new(0, 8, 0.5, -7)
            iconImg.BackgroundTransparency = 1
            iconImg.Image = link.iconUrl ~= "" and link.iconUrl or ""
            iconImg.ImageColor3 = Theme.state.accent
            iconImg.Parent = lb
            Theme:Listen(function(k, v) if k == "accent" then iconImg.ImageColor3 = v end end)

            -- Si no hay iconUrl, mostrar texto fallback
            if link.iconUrl == "" then
                iconImg:Destroy()
                lb.Text = "•  " .. link.label
            else
                -- Label al lado del icono
                local linkLbl = Instance.new("TextLabel")
                linkLbl.Size = UDim2.new(1, -30, 1, 0)
                linkLbl.Position = UDim2.new(0, 28, 0, 0)
                linkLbl.BackgroundTransparency = 1
                linkLbl.Text = link.label
                linkLbl.Font = Enum.Font.GothamSemibold
                linkLbl.TextSize = 11
                linkLbl.TextColor3 = Theme.state.accent
                linkLbl.TextXAlignment = Enum.TextXAlignment.Left
                linkLbl.Parent = lb
                Theme:Listen(function(k, v) if k == "accent" then linkLbl.TextColor3 = v end end)
            end

            lb.MouseEnter:Connect(function()
                tw(lb, 0.1, { BackgroundTransparency = 0.1 })
            end)
            lb.MouseLeave:Connect(function()
                tw(lb, 0.1, { BackgroundTransparency = 0.5 })
            end)
            lb.MouseButton1Click:Connect(function()
                if setclipboard then
                    setclipboard(link.url)
                    print("Link copiado: " .. link.url)
                else
                    print("Abrir: " .. link.url)
                end
            end)

            lx = lx + 98
        end

        -- Hover elevation
        card.InputBegan:Connect(function(inp)
            if inp.UserInputType == Enum.UserInputType.MouseMovement then
                tw(card, 0.15, { BackgroundTransparency = 0 })
            end
        end)
        card.InputEnded:Connect(function(inp)
            if inp.UserInputType == Enum.UserInputType.MouseMovement then
                tw(card, 0.15, { BackgroundTransparency = 0.1 })
            end
        end)
    end

    -- Info extra
    Controls.Section(pages.creditos, "Información")
    local infoBox = Instance.new("Frame")
    infoBox.Size = UDim2.new(1, 0, 0, 70)
    infoBox.BackgroundColor3 = Config.Panel
    infoBox.Parent = pages.creditos
    corner(infoBox, 10); uiStroke(infoBox, Config.Stroke, 1)
    local cTxt = Instance.new("TextLabel")
    cTxt.Size = UDim2.new(1, -20, 1, -16)
    cTxt.Position = UDim2.new(0, 10, 0, 8)
    cTxt.BackgroundTransparency = 1
    cTxt.Text = Config.Title .. "  v" .. Config.Version .. "\nHecho con ❤  —  Gracias por usar."
    cTxt.Font = Enum.Font.Gotham
    cTxt.TextSize = 13
    cTxt.TextColor3 = Config.Text
    cTxt.TextXAlignment = Enum.TextXAlignment.Left
    cTxt.TextYAlignment = Enum.TextYAlignment.Top
    cTxt.TextWrapped = true
    cTxt.Parent = infoBox
end

