-- ---- COLOR PICKER  (3 sliders R/G/B con preview) ----
function Controls.ColorPicker(parent, root, labelText, default, onChange)
    local c    = default or Color3.fromRGB(255, 255, 255)
    local r, g, b = math.floor(c.R*255+.5), math.floor(c.G*255+.5), math.floor(c.B*255+.5)

    local function update()
        local col = Color3.fromRGB(r, g, b)
        if onChange then onChange(col) end
        return col
    end

    -- fila de preview (cuadro de color actual)
    local previewRow = Instance.new("Frame")
    previewRow.Size = UDim2.new(1, 0, 0, 36)
    previewRow.BackgroundTransparency = 1
    previewRow.Parent = parent

    local previewLbl = Instance.new("TextLabel")
    previewLbl.Text = labelText
    previewLbl.Font = Enum.Font.Gotham
    previewLbl.TextSize = 14
    previewLbl.TextColor3 = Config.Text
    previewLbl.TextXAlignment = Enum.TextXAlignment.Left
    previewLbl.BackgroundTransparency = 1
    previewLbl.Size = UDim2.new(1, -44, 1, 0)
    previewLbl.Parent = previewRow

    local swatch = Instance.new("Frame")
    swatch.Size = UDim2.new(0, 28, 0, 20)
    swatch.Position = UDim2.new(1, -28, 0.5, -10)
    swatch.BackgroundColor3 = c
    swatch.BorderSizePixel = 0
    swatch.Parent = previewRow
    corner(swatch, 5); uiStroke(swatch, Config.Stroke, 1)

    local function refreshSwatch()
        swatch.BackgroundColor3 = Color3.fromRGB(r, g, b)
    end

    local sR = Controls.Slider(parent, "R", 0, 255, r, function(v)
        r = math.floor(v + .5); update(); refreshSwatch()
    end)
    local sG = Controls.Slider(parent, "G", 0, 255, g, function(v)
        g = math.floor(v + .5); update(); refreshSwatch()
    end)
    local sB = Controls.Slider(parent, "B", 0, 255, b, function(v)
        b = math.floor(v + .5); update(); refreshSwatch()
    end)

    return {
        Get = function() return Color3.fromRGB(r, g, b) end,
        Set = function(col)
            r = math.floor(col.R*255+.5)
            g = math.floor(col.G*255+.5)
            b = math.floor(col.B*255+.5)
            sR.Set(r); sG.Set(g); sB.Set(b)
            refreshSwatch()
        end,
    }
end

