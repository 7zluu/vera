local function runIntro(onDone)
    local sg = Instance.new("ScreenGui")
    sg.Name = "UI3R_Intro"
    sg.ResetOnSpawn = false
    sg.IgnoreGuiInset = true
    sg.DisplayOrder = 999
    sg.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
    sg.Parent = playerGui

    -- fondo oscuro
    local overlay = Instance.new("Frame")
    overlay.Size = UDim2.fromScale(1, 1)
    overlay.BackgroundColor3 = Color3.fromRGB(8, 8, 12)
    overlay.BackgroundTransparency = 0
    overlay.BorderSizePixel = 0
    overlay.Parent = sg

    -- brillo radial de fondo
    local glow = Instance.new("Frame")
    glow.Size = UDim2.fromOffset(520, 520)
    glow.AnchorPoint = Vector2.new(0.5, 0.5)
    glow.Position = UDim2.fromScale(0.5, 0.5)
    glow.BackgroundColor3 = Theme.state.accent
    glow.BackgroundTransparency = 1
    glow.BorderSizePixel = 0
    glow.Parent = overlay
    corner(glow, 99)
    Theme:Listen(function(k, v) if k == "accent" then glow.BackgroundColor3 = v end end)

    -- tarjeta central (empieza ligeramente abajo, invisible)
    local card = Instance.new("Frame")
    card.AnchorPoint = Vector2.new(0.5, 0.5)
    card.Position = UDim2.new(0.5, 0, 0.56, 0)
    card.Size = UDim2.fromOffset(300, 128)
    card.BackgroundColor3 = Color3.fromRGB(16, 16, 22)
    card.BackgroundTransparency = 1
    card.BorderSizePixel = 0
    card.Parent = sg
    corner(card, 20)
    uiStroke(card, Color3.fromRGB(55, 55, 75), 1)

    -- brillo superior de la tarjeta (glass)
    local shine = Instance.new("Frame")
    shine.Size = UDim2.new(1, 0, 0.45, 0)
    shine.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    shine.BackgroundTransparency = 0.94
    shine.BorderSizePixel = 0
    shine.Parent = card
    corner(shine, 20)
    local shineGrad = Instance.new("UIGradient")
    shineGrad.Rotation = 90
    shineGrad.Transparency = NumberSequence.new({
        NumberSequenceKeypoint.new(0, 0),
        NumberSequenceKeypoint.new(1, 1),
    })
    shineGrad.Parent = shine

    -- título
    local titleLbl = Instance.new("TextLabel")
    titleLbl.Size = UDim2.new(1, 0, 0, 50)
    titleLbl.Position = UDim2.new(0, 0, 0, 14)
    titleLbl.BackgroundTransparency = 1
    titleLbl.Text = Config.Title
    titleLbl.Font = Enum.Font.GothamBold
    titleLbl.TextSize = 38
    titleLbl.TextColor3 = Color3.fromRGB(240, 240, 248)
    titleLbl.TextTransparency = 1
    titleLbl.TextXAlignment = Enum.TextXAlignment.Center
    titleLbl.Parent = card

    -- subtítulo
    local subLbl = Instance.new("TextLabel")
    subLbl.Size = UDim2.new(1, 0, 0, 18)
    subLbl.Position = UDim2.new(0, 0, 0, 68)
    subLbl.BackgroundTransparency = 1
    subLbl.Text = "v" .. Config.Version .. "  —  cargando..."
    subLbl.Font = Enum.Font.Gotham
    subLbl.TextSize = 13
    subLbl.TextColor3 = Config.SubText
    subLbl.TextTransparency = 1
    subLbl.TextXAlignment = Enum.TextXAlignment.Center
    subLbl.Parent = card

    -- barra de progreso
    local barTrack = Instance.new("Frame")
    barTrack.Size = UDim2.new(0, 210, 0, 3)
    barTrack.AnchorPoint = Vector2.new(0.5, 1)
    barTrack.Position = UDim2.new(0.5, 0, 1, -16)
    barTrack.BackgroundColor3 = Color3.fromRGB(38, 38, 52)
    barTrack.BorderSizePixel = 0
    barTrack.Parent = card
    corner(barTrack, 2)

    local barFill = Instance.new("Frame")
    barFill.Size = UDim2.new(0, 0, 1, 0)
    barFill.BackgroundColor3 = Theme.state.accent
    barFill.BorderSizePixel = 0
    barFill.Parent = barTrack
    corner(barFill, 2)
    Theme:Listen(function(k, v) if k == "accent" then barFill.BackgroundColor3 = v end end)

    -- SECUENCIA
    task.spawn(function()
        task.wait(0.08)

        -- glow aparece
        tw(glow, 0.9, { BackgroundTransparency = 0.90 })

        -- tarjeta sube y aparece
        tw(card, 0.45, {
            Position = UDim2.new(0.5, 0, 0.5, 0),
            BackgroundTransparency = 0.08,
        }, Enum.EasingStyle.Back, Enum.EasingDirection.Out)

        task.wait(0.18)
        tw(titleLbl, 0.35, { TextTransparency = 0 })
        task.wait(0.14)
        tw(subLbl,   0.30, { TextTransparency = 0 })

        -- progress fill
        task.wait(0.08)
        tw(barFill, Config.IntroDuration - 0.65,
            { Size = UDim2.new(1, 0, 1, 0) },
            Enum.EasingStyle.Quad, Enum.EasingDirection.InOut)

        task.wait(Config.IntroDuration - 0.45)

        -- outro
        tw(overlay,  0.40, { BackgroundTransparency = 1 })
        tw(glow,     0.30, { BackgroundTransparency = 1 })
        tw(card,     0.35, { BackgroundTransparency = 1,
                              Position = UDim2.new(0.5, 0, 0.44, 0) })
        tw(titleLbl, 0.25, { TextTransparency = 1 })
        tw(subLbl,   0.25, { TextTransparency = 1 })
        tw(barTrack, 0.25, { BackgroundTransparency = 1 })
        tw(barFill,  0.25, { BackgroundTransparency = 1 })

        task.wait(0.42)
        sg:Destroy()
        if onDone then onDone() end
    end)
end

