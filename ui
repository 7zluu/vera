-- ============================================================
--  THEME  (sistema de eventos para cambios de color en tiempo real)
-- ============================================================
local Theme = { state = { accent = Config.Accent } }
local _listeners = {}

function Theme:Listen(fn)
    _listeners[#_listeners + 1] = fn
    return function()   -- devuelve función para desconectar
        for i, f in ipairs(_listeners) do
            if f == fn then table.remove(_listeners, i); break end
        end
    end
end

function Theme:Set(key, val)
    self.state[key] = val
    for _, fn in ipairs(_listeners) do task.spawn(fn, key, val) end
end

function Theme:Hex(c)
    return string.format("#%02X%02X%02X",
        math.floor(c.R*255+.5), math.floor(c.G*255+.5), math.floor(c.B*255+.5))
end

-- ============================================================
--  HELPERS
-- ============================================================
local function corner(p, r)
    local c = Instance.new("UICorner")
    c.CornerRadius = (r >= 99) and UDim.new(0.5, 0) or UDim.new(0, r)
    c.Parent = p; return c
end

local function uiStroke(p, col, thick)
    local s = Instance.new("UIStroke")
    s.Color = col; s.Thickness = thick or 1
    s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
    s.Parent = p; return s
end

local function tw(inst, t, props, style, dir)
    TweenService:Create(inst,
        TweenInfo.new(t,
            style or Enum.EasingStyle.Quad,
            dir   or Enum.EasingDirection.Out),
        props):Play()
end

local function makeDraggable(frame, bar)
    local drag, start, orig = false
    bar.InputBegan:Connect(function(inp)
        if inp.UserInputType == Enum.UserInputType.MouseButton1
        or inp.UserInputType == Enum.UserInputType.Touch then
            drag = true; start = inp.Position; orig = frame.Position
        end
    end)
    UserInputService.InputChanged:Connect(function(inp)
        if drag and (inp.UserInputType == Enum.UserInputType.MouseMovement
        or inp.UserInputType == Enum.UserInputType.Touch) then
            local d = inp.Position - start
            frame.Position = UDim2.new(
                orig.X.Scale, orig.X.Offset + d.X,
                orig.Y.Scale, orig.Y.Offset + d.Y)
        end
    end)
    UserInputService.InputEnded:Connect(function(inp)
        if inp.UserInputType == Enum.UserInputType.MouseButton1
        or inp.UserInputType == Enum.UserInputType.Touch then drag = false end
    end)
end

