-- ---- TOGGLE ----
function Controls.Toggle(parent, labelText, default, onChange)
    local row = Instance.new("Frame")
    row.Size = UDim2.new(1, 0, 0, 36)
    row.BackgroundTransparency = 1
    row.Parent = parent

    local lbl = Instance.new("TextLabel")
    lbl.Text = labelText
    lbl.Font = Enum.Font.Gotham
    lbl.TextSize = 14
    lbl.TextColor3 = Config.Text
    lbl.TextXAlignment = Enum.TextXAlignment.Left
    lbl.BackgroundTransparency = 1
    lbl.Size = UDim2.new(1, -56, 1, 0)
    lbl.Parent = row

    local track = Instance.new("Frame")
    track.Size = UDim2.new(0, 44, 0, 24)
    track.Position = UDim2.new(1, -44, 0.5, -12)
    track.BackgroundColor3 = Color3.fromRGB(48, 48, 60)
    track.Parent = row
    corner(track, 12)

    local knob = Instance.new("Frame")
    knob.Size = UDim2.new(0, 20, 0, 20)
    knob.Position = UDim2.new(0, 2, 0.5, -10)
    knob.BackgroundColor3 = Color3.fromRGB(210, 210, 225)
    knob.Parent = track
    corner(knob, 10)

    local state = { on = default == true }

    local function refresh(animate)
        local pos = state.on
            and UDim2.new(1, -22, 0.5, -10)
            or  UDim2.new(0,   2, 0.5, -10)
        local col = state.on and Theme.state.accent or Color3.fromRGB(48, 48, 60)
        if animate == false then
            knob.Position = pos; track.BackgroundColor3 = col
        else
            tw(knob, 0.14, { Position = pos })
            tw(track, 0.14, { BackgroundColor3 = col })
        end
    end
    refresh(false)
    Theme:Listen(function(k) if k == "accent" and state.on then refresh() end end)

    -- área clickeable transparente encima de todo
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(1, 0, 1, 0)
    btn.BackgroundTransparency = 1
    btn.Text = ""
    btn.Parent = row
    btn.MouseButton1Click:Connect(function()
        state.on = not state.on
        refresh()
        if onChange then onChange(state.on) end
    end)

    return {
        Get = function() return state.on end,
        Set = function(v)
            state.on = (v == true)
            refresh()
            -- NO dispara onChange al Set programático (igual que iOS)
        end,
    }
end

-- ---- SLIDER ----
function Controls.Slider(parent, labelText, minV, maxV, defaultV, onChange)
    local row = Instance.new("Frame")
    row.Size = UDim2.new(1, 0, 0, 52)
    row.BackgroundTransparency = 1
    row.Parent = parent

    local lbl = Instance.new("TextLabel")
    lbl.Text = labelText
    lbl.Font = Enum.Font.Gotham
    lbl.TextSize = 14
    lbl.TextColor3 = Config.Text
    lbl.TextXAlignment = Enum.TextXAlignment.Left
    lbl.BackgroundTransparency = 1
    lbl.Size = UDim2.new(1, -58, 0, 20)
    lbl.Parent = row

    local valLbl = Instance.new("TextLabel")
    valLbl.Font = Enum.Font.GothamBold
    valLbl.TextSize = 13
    valLbl.TextColor3 = Theme.state.accent
    valLbl.TextXAlignment = Enum.TextXAlignment.Right
    valLbl.BackgroundTransparency = 1
    valLbl.Size = UDim2.new(0, 52, 0, 20)
    valLbl.Position = UDim2.new(1, -52, 0, 0)
    valLbl.Parent = row
    Theme:Listen(function(k, v) if k == "accent" then valLbl.TextColor3 = v end end)

    local track = Instance.new("Frame")
    track.Size = UDim2.new(1, 0, 0, 5)
    track.Position = UDim2.new(0, 0, 0, 34)
    track.BackgroundColor3 = Color3.fromRGB(44, 44, 56)
    track.Parent = row
    corner(track, 3)

    local fill = Instance.new("Frame")
    fill.Size = UDim2.new(0, 0, 1, 0)
    fill.BackgroundColor3 = Theme.state.accent
    fill.BorderSizePixel = 0
    fill.Parent = track
    corner(fill, 3)
    Theme:Listen(function(k, v) if k == "accent" then fill.BackgroundColor3 = v end end)

    local knob = Instance.new("Frame")
    knob.Size = UDim2.new(0, 14, 0, 14)
    knob.AnchorPoint = Vector2.new(0.5, 0.5)
    knob.Position = UDim2.new(0, 0, 0.5, 0)
    knob.BackgroundColor3 = Color3.fromRGB(240, 240, 248)
    knob.Parent = track
    corner(knob, 7)

    local value = defaultV or minV
    local function setV(v, silent)
        value = math.clamp(v, minV, maxV)
        local alpha = (value - minV) / math.max(1, maxV - minV)
        fill.Size = UDim2.new(alpha, 0, 1, 0)
        knob.Position = UDim2.new(alpha, 0, 0.5, 0)
        valLbl.Text = tostring(math.floor(value + 0.5))
        if not silent and onChange then onChange(value) end
    end
    setV(value, true)

    local dragging = false
    local function fromX(x)
        local abs = track.AbsolutePosition.X
        local sz  = math.max(1, track.AbsoluteSize.X)
        setV(minV + math.clamp((x - abs) / sz, 0, 1) * (maxV - minV))
    end
    track.InputBegan:Connect(function(inp)
        if inp.UserInputType == Enum.UserInputType.MouseButton1
        or inp.UserInputType == Enum.UserInputType.Touch then
            dragging = true; fromX(inp.Position.X)
        end
    end)
    UserInputService.InputChanged:Connect(function(inp)
        if dragging and (inp.UserInputType == Enum.UserInputType.MouseMovement
        or inp.UserInputType == Enum.UserInputType.Touch) then
            fromX(inp.Position.X)
        end
    end)
    UserInputService.InputEnded:Connect(function() dragging = false end)

    return {
        Get = function() return value end,
        Set = function(v) setV(v, true) end,
    }
end

-- ---- DROPDOWN  (popup en gui root → sin clipping) ----
function Controls.Dropdown(parent, root, labelText, options, defaultIdx, onChange)
    local row = Instance.new("Frame")
    row.Size = UDim2.new(1, 0, 0, 36)
    row.BackgroundTransparency = 1
    row.Parent = parent

    local lbl = Instance.new("TextLabel")
    lbl.Text = labelText
    lbl.Font = Enum.Font.Gotham
    lbl.TextSize = 14
    lbl.TextColor3 = Config.Text
    lbl.TextXAlignment = Enum.TextXAlignment.Left
    lbl.BackgroundTransparency = 1
    lbl.Size = UDim2.new(0.52, 0, 1, 0)
    lbl.Parent = row

    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(0, 136, 0, 26)
    btn.Position = UDim2.new(1, -136, 0.5, -13)
    btn.BackgroundColor3 = Config.Panel
    btn.Text = "▾  " .. (options[defaultIdx or 1] or "")
    btn.Font = Enum.Font.Gotham
    btn.TextSize = 13
    btn.TextColor3 = Config.Text
    btn.Parent = row
    corner(btn, 6); uiStroke(btn, Config.Stroke, 1)

    -- popup a nivel de gui root para evitar ClipsDescendants
    local menu = Instance.new("Frame")
    menu.Size = UDim2.new(0, 136, 0, 0)
    menu.BackgroundColor3 = Color3.fromRGB(20, 20, 28)
    menu.Visible = false
    menu.ZIndex = 60
    menu.ClipsDescendants = true
    menu.Parent = root
    corner(menu, 8); uiStroke(menu, Config.Stroke, 1)

    local mlay = Instance.new("UIListLayout")
    mlay.Padding = UDim.new(0, 2)
    mlay.Parent = menu
    local mpad = Instance.new("UIPadding")
    mpad.PaddingTop = UDim.new(0, 4); mpad.PaddingBottom = UDim.new(0, 4)
    mpad.PaddingLeft = UDim.new(0, 4); mpad.PaddingRight = UDim.new(0, 4)
    mpad.Parent = menu

    local selected = defaultIdx or 1
    local open = false
    local targetH = #options * 28 + 10

    local function closeMenu()
        open = false
        tw(menu, 0.12, { Size = UDim2.new(0, 136, 0, 0) })
        task.delay(0.13, function() menu.Visible = false end)
    end

    for i, opt in ipairs(options) do
        local it = Instance.new("TextButton")
        it.Size = UDim2.new(1, 0, 0, 26)
        it.BackgroundColor3 = Color3.fromRGB(28, 28, 38)
        it.Text = opt
        it.Font = Enum.Font.Gotham
        it.TextSize = 13
        it.TextColor3 = Config.Text
        it.ZIndex = 61
        it.Parent = menu
        corner(it, 5)
        it.MouseEnter:Connect(function()
            tw(it, 0.09, { BackgroundColor3 = Color3.fromRGB(44, 44, 58) })
        end)
        it.MouseLeave:Connect(function()
            tw(it, 0.09, { BackgroundColor3 = Color3.fromRGB(28, 28, 38) })
        end)
        it.MouseButton1Click:Connect(function()
            selected = i
            btn.Text = "▾  " .. opt
            closeMenu()
            if onChange then onChange(opt, i) end
        end)
    end

    btn.MouseButton1Click:Connect(function()
        open = not open
        if open then
            local abs = btn.AbsolutePosition
            menu.Position = UDim2.fromOffset(abs.X, abs.Y + btn.AbsoluteSize.Y + 4)
            menu.Size = UDim2.new(0, 136, 0, 0)
            menu.Visible = true
            tw(menu, 0.15, { Size = UDim2.new(0, 136, 0, targetH) })
        else
            closeMenu()
        end
    end)

    -- cerrar al hacer click fuera
    UserInputService.InputBegan:Connect(function(inp)
        if open and inp.UserInputType == Enum.UserInputType.MouseButton1 then
            task.defer(function()
                local mp  = UserInputService:GetMouseLocation()
                local abs = menu.AbsolutePosition
                local sz  = menu.AbsoluteSize
                local inside = mp.X >= abs.X and mp.X <= abs.X + sz.X
                           and mp.Y >= abs.Y and mp.Y <= abs.Y + sz.Y
                if not inside then closeMenu() end
            end)
        end
    end)

    return {
        Get = function() return options[selected], selected end,
        Set = function(idx)
            selected = idx
            btn.Text = "▾  " .. (options[idx] or "")
        end,
    }
end

