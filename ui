local function buildUI()
    -- ScreenGui
    local gui = Instance.new("ScreenGui")
    gui.Name = "UI3R"
    gui.ResetOnSpawn = false
    gui.IgnoreGuiInset = true
    gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
    gui.Parent = playerGui

    -- escala responsiva
    local uisc = Instance.new("UIScale"); uisc.Parent = gui
    local function recalc()
        local cam = workspace.CurrentCamera
        if not cam then return end
        local vp = cam.ViewportSize
        uisc.Scale = math.clamp(
            math.min(vp.X / 900, vp.Y / 600),
            Config.MinScale, Config.MaxScale)
    end
    recalc()
    workspace:GetPropertyChangedSignal("CurrentCamera"):Connect(function()
        if workspace.CurrentCamera then
            workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(recalc)
            recalc()
        end
    end)

    -- ventana principal
    local win = Instance.new("Frame")
    win.Name = "Window"
    win.Size = UDim2.fromOffset(Config.WindowW, Config.WindowH)
    win.AnchorPoint = Vector2.new(0.5, 0.5)
    win.Position = UDim2.new(0.5, 0, 0.5, 0)
    win.BackgroundColor3 = Config.Bg
    win.BackgroundTransparency = Config.BgAlpha
    win.ClipsDescendants = true
    win.ZIndex = 2
    win.Parent = gui
    corner(win, 16); uiStroke(win, Config.Stroke, 1)

    -- gradiente de fondo de la ventana
    local bgGrad = Instance.new("Frame")
    bgGrad.Size = UDim2.fromScale(1, 1)
    bgGrad.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    bgGrad.BackgroundTransparency = 0.96
    bgGrad.BorderSizePixel = 0
    bgGrad.ZIndex = 1
    bgGrad.Parent = win
    corner(bgGrad, 16)
    local gg = Instance.new("UIGradient")
    gg.Rotation = 125
    gg.Transparency = NumberSequence.new({
        NumberSequenceKeypoint.new(0,   0.0),
        NumberSequenceKeypoint.new(0.5, 0.9),
        NumberSequenceKeypoint.new(1,   1.0),
    })
    gg.Parent = bgGrad

    -- imagen de fondo (si se configura)
    if Config.BgImage ~= "" then
        local img = Instance.new("ImageLabel")
        img.Size = UDim2.fromScale(1, 1)
        img.BackgroundTransparency = 1
        img.ScaleType = Enum.ScaleType.Crop
        img.ImageTransparency = Config.BgImageAlpha
        img.Image = Config.BgImage
        img.ZIndex = 1
        img.Parent = win
        corner(img, 16)
    end

    -- ==== TOP BAR ====
    local topBar = Instance.new("Frame")
    topBar.Size = UDim2.new(1, 0, 0, 44)
    topBar.BackgroundTransparency = 1
    topBar.ZIndex = 10
    topBar.Parent = win

    -- acento vertical izquierdo
    local strip = Instance.new("Frame")
    strip.Size = UDim2.new(0, 3, 0, 22)
    strip.Position = UDim2.new(0, 14, 0.5, -11)
    strip.BackgroundColor3 = Theme.state.accent
    strip.BorderSizePixel = 0
    strip.ZIndex = 11
    strip.Parent = topBar
    corner(strip, 2)
    Theme:Listen(function(k, v) if k == "accent" then strip.BackgroundColor3 = v end end)

    local titleLbl = Instance.new("TextLabel")
    titleLbl.Text = Config.Title
    titleLbl.Font = Enum.Font.GothamBold
    titleLbl.TextSize = 17
    titleLbl.TextColor3 = Config.Text
    titleLbl.TextXAlignment = Enum.TextXAlignment.Left
    titleLbl.BackgroundTransparency = 1
    titleLbl.Size = UDim2.new(0, 100, 1, 0)
    titleLbl.Position = UDim2.new(0, 24, 0, 0)
    titleLbl.ZIndex = 11
    titleLbl.Parent = topBar

    local verLbl = Instance.new("TextLabel")
    verLbl.Text = "v" .. Config.Version
    verLbl.Font = Enum.Font.Gotham
    verLbl.TextSize = 12
    verLbl.TextColor3 = Config.SubText
    verLbl.TextXAlignment = Enum.TextXAlignment.Left
    verLbl.BackgroundTransparency = 1
    verLbl.Size = UDim2.new(0, 50, 1, 0)
    verLbl.Position = UDim2.new(0, 80, 0, 0)
    verLbl.ZIndex = 11
    verLbl.Parent = topBar

    -- botones de la topbar
    local function topBtn(txt, xOff, fn)
        local b = Instance.new("TextButton")
        b.Text = txt
        b.Font = Enum.Font.GothamBold
        b.TextSize = 14
        b.TextColor3 = Config.SubText
        b.BackgroundColor3 = Color3.fromRGB(38, 38, 52)
        b.BackgroundTransparency = 0.5
        b.Size = UDim2.new(0, 26, 0, 26)
        b.Position = UDim2.new(1, xOff, 0.5, -13)
        b.ZIndex = 11
        b.Parent = topBar
        corner(b, 6)
        b.MouseEnter:Connect(function() tw(b, 0.1, { BackgroundTransparency = 0.1 }) end)
        b.MouseLeave:Connect(function() tw(b, 0.1, { BackgroundTransparency = 0.5 }) end)
        b.MouseButton1Click:Connect(fn)
        return b
    end

    -- separador horizontal bajo topbar
    local topDiv = Instance.new("Frame")
    topDiv.Size = UDim2.new(1, -28, 0, 1)
    topDiv.Position = UDim2.new(0, 14, 0, 43)
    topDiv.BackgroundColor3 = Config.Stroke
    topDiv.BorderSizePixel = 0
    topDiv.ZIndex = 10
    topDiv.Parent = win

    -- ==== TAB BAR ====
    local tabBar = Instance.new("Frame")
    tabBar.Size = UDim2.new(1, -28, 0, 32)
    tabBar.Position = UDim2.new(0, 14, 0, 50)
    tabBar.BackgroundTransparency = 1
    tabBar.ZIndex = 10
    tabBar.Parent = win

    local tabLayout = Instance.new("UIListLayout")
    tabLayout.FillDirection = Enum.FillDirection.Horizontal
    tabLayout.Padding = UDim.new(0, 8)
    tabLayout.VerticalAlignment = Enum.VerticalAlignment.Center
    tabLayout.Parent = tabBar

    -- indicador deslizante bajo la tab activa
    local indicator = Instance.new("Frame")
    indicator.Size = UDim2.new(0, 10, 0, 2)
    indicator.Position = UDim2.new(0, 0, 1, -1)
    indicator.BackgroundColor3 = Theme.state.accent
    indicator.BorderSizePixel = 0
    indicator.ZIndex = 11
    indicator.Parent = tabBar
    corner(indicator, 1)
    Theme:Listen(function(k, v) if k == "accent" then indicator.BackgroundColor3 = v end end)

    -- ==== CONTENT AREA ====
    local contentArea = Instance.new("Frame")
    contentArea.Size = UDim2.new(1, -28, 1, -98)
    contentArea.Position = UDim2.new(0, 14, 0, 90)
    contentArea.BackgroundTransparency = 1
    contentArea.ZIndex = 5
    contentArea.Parent = win

    local pages = {}

    -- construye una página con scroll
    local function makePage(tabName)
        local pg = Instance.new("ScrollingFrame")
        pg.Size = UDim2.fromScale(1, 1)
        pg.BackgroundTransparency = 1
        pg.BorderSizePixel = 0
        pg.ScrollBarThickness = 3
        pg.ScrollBarImageColor3 = Config.Stroke
        pg.AutomaticCanvasSize = Enum.AutomaticSize.Y
        pg.CanvasSize = UDim2.new(0, 0, 0, 0)
        pg.Visible = false
        pg.Parent = contentArea

        local lay = Instance.new("UIListLayout")
        lay.Padding = UDim.new(0, 4)
        lay.Parent = pg

        local padPg = Instance.new("UIPadding")
        padPg.PaddingBottom = UDim.new(0, 10)
        padPg.PaddingLeft  = UDim.new(0, 2)
        padPg.PaddingRight = UDim.new(0, 6)
        padPg.Parent = pg

        return pg
    end

    for _, t in ipairs(Config.Tabs) do
        pages[t] = makePage(t)
    end

    -- lógica de selección de tab
    local currentTab = nil
    local function selectTab(name)
        currentTab = name
        for n, pg in pairs(pages) do
            pg.Visible = (n == name)
        end
        for _, tb in ipairs(tabBar:GetChildren()) do
            if tb:IsA("TextButton") then
                local isSel = tb:GetAttribute("tab") == name
                tw(tb, 0.14, {
                    TextColor3 = isSel and Config.Text or Config.SubText
                })
                if isSel then
                    local abs    = tb.AbsolutePosition
                    local tabAbs = tabBar.AbsolutePosition
                    tw(indicator, 0.18, {
                        Position = UDim2.new(0, abs.X - tabAbs.X, 1, -1),
                        Size     = UDim2.new(0, tb.AbsoluteSize.X, 0, 2),
                    }, Enum.EasingStyle.Quad)
                end
            end
        end
    end

    -- crea los botones de tab (auto-ancho)
    for _, tabName in ipairs(Config.Tabs) do
        local tb = Instance.new("TextButton")
        tb.Text = tabName
        tb.Font = Enum.Font.GothamSemibold
        tb.TextSize = 13
        tb.TextColor3 = Config.SubText
        tb.BackgroundTransparency = 1
        tb.AutomaticSize = Enum.AutomaticSize.X
        tb.Size = UDim2.new(0, 0, 1, 0)
        tb.ZIndex = 11
        tb:SetAttribute("tab", tabName)
        tb.Parent = tabBar
        local pad2 = Instance.new("UIPadding")
        pad2.PaddingLeft = UDim.new(0, 4); pad2.PaddingRight = UDim.new(0, 4)
        pad2.Parent = tb
        tb.MouseButton1Click:Connect(function() selectTab(tabName) end)
    end

    -- ==== PILL (minimizado) ====
    local pill = Instance.new("TextButton")
    pill.Name = "Pill"
    pill.Size = UDim2.fromOffset(128, 32)
    pill.Position = UDim2.new(0.5, -64, 0, 14)
    pill.BackgroundColor3 = Config.Bg
    pill.BackgroundTransparency = 0.28
    pill.Text = "◉  " .. Config.Title
    pill.Font = Enum.Font.GothamBold
    pill.TextSize = 13
    pill.TextColor3 = Theme.state.accent
    pill.Visible = false
    pill.ZIndex = 20
    pill.Parent = gui
    corner(pill, 16); uiStroke(pill, Config.Stroke, 1)
    makeDraggable(pill, pill)
    pill.MouseButton1Click:Connect(function()
        pill.Visible = false; win.Visible = true
    end)
    Theme:Listen(function(k, v) if k == "accent" then pill.TextColor3 = v end end)

    topBtn("−", -62, function()
        win.Visible = false; pill.Visible = true
    end)
    topBtn("×", -32, function()
        win.Visible = false; pill.Visible = true
    end)
    makeDraggable(win, topBar)

    -- seleccionar primer tab después de que el layout resuelva tamaños
    task.defer(function() selectTab(Config.Tabs[1]) end)

    -- seleccionar de nuevo cuando el acento cambie (actualiza indicador)
    Theme:Listen(function(k)
        if k == "accent" and currentTab then
            task.defer(function() selectTab(currentTab) end)
        end
    end)

    return { Pages = pages, Gui = gui }
end

