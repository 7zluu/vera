        pg.BorderSizePixel = 0
        pg.ScrollBarThickness = 3
        pg.ScrollBarImageColor3 = Config.Stroke
        pg.AutomaticCanvasSize = Enum.AutomaticSize.Y
        pg.CanvasSize = UDim2.new(0, 0, 0, 0)
        pg.Visible = false
        pg.Parent = contentArea
        local lay = Instance.new("UIListLayout")
        lay.Padding = UDim.new(0, 4); lay.Parent = pg
        local padPg = Instance.new("UIPadding")
        padPg.PaddingBottom = UDim.new(0, 10)
        padPg.PaddingLeft  = UDim.new(0, 2)
        padPg.PaddingRight = UDim.new(0, 6)
        padPg.Parent = pg
        return pg
    end
    for _, t in ipairs(Config.Tabs) do pages[t] = makePage(t) end

    local currentTab = nil
    local function selectTab(name)
        currentTab = name
        for n, pg in pairs(pages) do pg.Visible = (n == name) end
        for _, tb in ipairs(tabBar:GetChildren()) do
            if tb:IsA("TextButton") then
                local isSel = tb:GetAttribute("tab") == name
                tw(tb, 0.14, { TextColor3 = isSel and Config.Text or Config.SubText })
                if isSel then
                    local abs    = tb.AbsolutePosition
                    local tabAbs = tabBar.AbsolutePosition
                    tw(indicator, 0.18, {
                        Position = UDim2.new(0, abs.X - tabAbs.X, 1, -1),
                        Size     = UDim2.new(0, tb.AbsoluteSize.X, 0, 2),
                    }, Enum.EasingStyle.Quad)
                end
            end
        end
    end

    for _, tabName in ipairs(Config.Tabs) do
        local tb = Instance.new("TextButton")
        tb.Text = tabName
        tb.Font = Enum.Font.GothamSemibold
        tb.TextSize = 13
        tb.TextColor3 = Config.SubText
        tb.BackgroundTransparency = 1
        tb.AutomaticSize = Enum.AutomaticSize.X
        tb.Size = UDim2.new(0, 0, 1, 0)
        tb.ZIndex = 11
        tb:SetAttribute("tab", tabName)
        tb.Parent = tabBar
        local pad2 = Instance.new("UIPadding")
        pad2.PaddingLeft = UDim.new(0, 4); pad2.PaddingRight = UDim.new(0, 4)
        pad2.Parent = tb
        tb.MouseButton1Click:Connect(function() selectTab(tabName) end)
    end

    local pill = Instance.new("TextButton")
    pill.Name = "Pill"
    pill.Size = UDim2.fromOffset(128, 32)
    pill.Position = UDim2.new(0.5, -64, 0, 14)
